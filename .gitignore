# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env.local
.env.*.local
.firebase/

# FCM service worker is generated at build/dev time from
# firebase-messaging-sw.template.js by vite.config.js
public/firebase-messaging-sw.js

# Firebase Admin service account keys — never commit these
service-account.json
*-service-account.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Installed tooling, not project source
.claude/skills/

# Seeded design canvas: ~2.6 MB, almost all of it the bundled editor payload.
# Regenerable from the .dc.html artboards + canvas.json — see
# trikekoto_app/docs/wireframes/README.md
trikekoto_app/docs/wireframes/*-screen-plates.html

# Local Claude Code permissions — machine-specific absolute paths
.claude/settings.local.json
